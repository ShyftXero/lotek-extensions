  "phases": [
    {
      "n": 0,
      "intro": true,
      "title": "How lotek works"
    },
    {
      "n": 1,
      "title": "Deploy a runner",
      "desc": "Install a runner and point it at the dashboard. It exchanges keys once, then sends encrypted heartbeats that report its version, tools and capabilities. The runner always connects out; the dashboard never connects in.",
      "targets": [
        "runner",
        "dashboard"
      ],
      "links": [
        {
          "label": "How work moves through lotek — 3. Runners: enroll, heartbeat, claim",
          "href": "/docs#dataflow-3-runners-enroll-heartbeat-claim"
        }
      ]
    },
    {
      "n": 2,
      "title": "Open an engagement",
      "desc": "Every scan belongs to one client and one engagement. Memberships on the engagement decide who can read the work and who can run it.",
      "targets": [
        "engagement"
      ],
      "links": [
        {
          "label": "How work moves through lotek — 1. Tenancy: client, engagement, job",
          "href": "/docs#dataflow-1-tenancy-client-engagement-job"
        },
        {
          "label": "How work moves through lotek — 5. Access: who may see and control a job",
          "href": "/docs#dataflow-5-access-who-may-see-and-control-a-job"
        }
      ]
    },
    {
      "n": 3,
      "title": "Declare scope",
      "desc": "Scope lists the IPs, ranges and hostnames you are allowed to test. Exclusions win. One function decides every target, and it is checked again when the job is saved.",
      "targets": [
        "engagement",
        "scope"
      ],
      "links": [
        {
          "label": "How work moves through lotek — 4. Scope: which targets are legal",
          "href": "/docs#dataflow-4-scope-which-targets-are-legal"
        }
      ]
    },
    {
      "n": 4,
      "title": "Queue a scan",
      "desc": "Pick modules and targets. A quick scan is queued now; a future assessment is scheduled.",
      "targets": [
        "dashboard",
        "job"
      ],
      "links": [
        {
          "label": "How work moves through lotek — 6. Job lifecycle",
          "href": "/docs#dataflow-6-job-lifecycle"
        }
      ]
    },
    {
      "n": 5,
      "title": "The runner claims and runs it",
      "desc": "The runner picks up work it is able to run. Exactly one runner wins each job. Output is swept into the object store as the job finishes.",
      "targets": [
        "runner",
        "job",
        "store"
      ],
      "links": [
        {
          "label": "How work moves through lotek — 3. Runners: enroll, heartbeat, claim",
          "href": "/docs#dataflow-3-runners-enroll-heartbeat-claim"
        },
        {
          "label": "How work moves through lotek — 10. Storage: object store and retention",
          "href": "/docs#dataflow-10-storage-object-store-and-retention"
        }
      ]
    },
    {
      "n": 6,
      "title": "Results become findings",
      "desc": "The dashboard parses tool output into assets, services and de-duplicated findings. Re-parsing the same output changes nothing.",
      "targets": [
        "leader",
        "findings"
      ],
      "links": [
        {
          "label": "How work moves through lotek — 7. Normalization: raw output to findings",
          "href": "/docs#dataflow-7-normalization-raw-output-to-findings"
        }
      ]
    },
    {
      "n": 7,
      "title": "Triage",
      "desc": "An operator marks each finding: triaged, accepted risk, false positive, fixed, or needs retest. Findings group by issue or by host.",
      "targets": [
        "operator",
        "findings"
      ],
      "links": [
        {
          "label": "How work moves through lotek — 8. Triage and decisioning",
          "href": "/docs#dataflow-8-triage-and-decisioning"
        }
      ]
    },
    {
      "n": 8,
      "title": "Build the deliverable",
      "desc": "Adopt the job into a Scribble report, which copies its findings into the engagement's report. A job can also seed a Vector attack-path diagram.",
      "targets": [
        "findings",
        "report",
        "diagram"
      ],
      "links": [
        {
          "label": "How work moves through lotek — 9. Deliverables: Scribble reports and Vector diagrams",
          "href": "/docs#dataflow-9-deliverables-scribble-reports-and-vector-diagrams"
        }
      ]
    },
    {
      "n": 9,
      "title": "Deliver",
      "desc": "Share the live HTML report or export HTML, a ZIP with artifacts, JSON, CSV or DOCX.",
      "targets": [
        "report",
        "client"
      ],
      "links": [
        {
          "label": "How work moves through lotek — 9. Deliverables: Scribble reports and Vector diagrams",
          "href": "/docs#dataflow-9-deliverables-scribble-reports-and-vector-diagrams"
        }
      ]
    }
  ],
