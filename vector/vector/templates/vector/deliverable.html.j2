<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="vector.attackpath">
<title>{{ title }}</title>
<style>
html,body{margin:0;height:100%;background:#0a0f14}
{% if footer %}
/* The viewer fills the viewport (html,body height:100%), so a fixed footer would sit ON TOP of the
   bottom of the canvas in a CLIENT-FACING deliverable. Reserve the strip instead of overlaying it.
   Emitted only when there IS a footer — a `body:has(...)` selector would do the same thing but
   silently degrade back to the overlay bug in a renderer that lacks :has(), and this is a file a
   client opens in whatever they happen to have. */
body{padding-bottom:28px;box-sizing:border-box}
{% endif %}
.vap-deliverable-footer{position:fixed;left:0;right:0;bottom:0;padding:6px 14px;font:600 11px/1.4 system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;letter-spacing:.06em;text-transform:uppercase;color:#7f93a3;background:rgba(10,15,20,.92);border-top:1px solid #1c2a35;text-align:center;z-index:9}
{{ css }}
</style>
</head>
<body>
<div id="vap"></div>
{% if footer %}<footer class="vap-deliverable-footer">{{ footer }}</footer>{% endif %}
<script type="application/json" id="vap-model">{{ model_json }}</script>
<script>
  try { window.__VECTOR_MODEL__ = JSON.parse(document.getElementById('vap-model').textContent); }
  catch (e) { window.__VECTOR_MODEL__ = { schema: "vector.attackpath/v1", meta: { title: "Parse error" }, zones: [], nodes: [], edges: [], phases: [] }; }
</script>
<script>{{ js }}</script>
</body>
</html>
